# ==============================================================
# AI Chatbot Configuration
# Copy this file to .env and insert your API key:
#   cp .env.example .env
# ==============================================================

# Option 1: OpenAI (Default)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Option 2: Groq (Free & Fast Llama-3 models)
# Get a free key at: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_groq_key_here
# AI_MODEL=llama-3.3-70b-versatile

# Option 3: Google Gemini
# Get a free key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy_your_gemini_key_here
# AI_MODEL=gemini-1.5-flash

# Optional: Default System Prompt
SYSTEM_PROMPT="You are a helpful, knowledgeable, and polite AI assistant. Provide clear, accurate, and concise answers using markdown when appropriate."
